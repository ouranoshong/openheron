# mcps/example.yaml.disabled
#
# ★ This is an EXAMPLE, not a configuration. The file's name says so, and
#   that matters: a file under mcps/ **defines** a server — the file's
#   presence is the definition, there is no "enabled" key. So a live
#   example.yaml would make every agent that does not narrow its list try
#   to start a server that is not installed.
#
# ★ Renaming it to <server>.yaml is the act of defining that server.
#
# ── the fields ───────────────────────────────────────────────────────────
#
# transport   stdio (a child process) or http (streamable HTTP). There is
#             no SSE transport, and an unknown transport is a load-time
#             error — a typo must not run a different server.
# command     required for a stdio server; resolved in the sandbox's PATH,
#             never against the project root.
# args        the command's arguments.
# env         stdio only. The child's environment is this process's
#             environment with these variables layered on top — the same
#             name, the configuration wins. An http server may not declare
#             it at all: it has no child to hand an environment to.
# url         required for an http server.
# headers     http only; sent on every request.
# timeout     the ceiling for connect + initialize + list tools.
# call_timeout the ceiling for one tool call.
# tools       a filter: the server's own tool names to offer out of the
#             ones it has. Absent or empty means all of them.
# allows      the server's own tool names that run without a nod. ★ The
#             default is ask, so an empty list means "every tool of this
#             server asks" — including the tools it has not offered yet.
transport: stdio
command: npx
args: ["-y", "@modelcontextprotocol/server-github"]
env:
  # ★ Expanded at load time. In a sandbox the variable holds a sentinel and
  #   the host proxy swaps in the real key on the way out — so nothing in
  #   this file has to name the credential.
  GITHUB_TOKEN: ${GITHUB_TOKEN}
timeout: 30s
call_timeout: 60s
# ★ The tools to offer, by the server's own names, picked out of the ones
#   the server actually has. Absent = all of them.
tools: []
# ★ The exceptions: these run without a nod, everything else asks.
allows: [read_issue, list_issues]
