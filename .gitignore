# Build artifacts
/bin/
/tmp/
/openheron
openheron

# Multi-platform release artifacts (make release)
/dist/

# ★ web/dist is ignored as a whole, but .gitkeep must stay.
#   go:embed fails at **compile time** when its target directory matches no
#   file at all, and web/dist is the target of //go:embed all:web/dist (see
#   main.go). Without this exception, a fresh clone cannot even build after
#   touching only Go code.
# ★ Both exception rules are needed: `!/web/dist/.gitkeep` alone does not work.
#   git decides directory by directory whether to descend, so once /web/dist is
#   excluded wholesale it never descends into the children and that `!` rule
#   never gets a chance to match.
#   (Measured: with only `!/web/dist/.gitkeep`, `git add` reports "paths are
#     ignored", and web/dist does not exist in a fresh clone → `go build`
#     reports "pattern all:web/dist: no matching files found".)
!/web/dist/
web/dist/*
!/web/dist/.gitkeep

# Frontend
/web/node_modules/
/web/.vite/
/web/.rolldown/
*.tsbuildinfo

# Runtime data
/data/
# The real local configuration (the factory sample is in .openheron-example/);
# untracked, so that personal configuration and secrets stay out of the repo
/.openheron/
*.db
*.db-journal
*.db-wal

# Sessions and the working directory (an agent may have written anything here)
/workspace/

# Test-only root (ports and paths are in .env.test)
/.openheron-test/
/sessions/

# Local configuration overrides — may contain an api key
/config.local.yaml
.env
.env.*
!.env.example
# The test environment config **must** be committed — it is the single source
# of truth for the ports and paths, read by three places (Vite / Playwright /
# the smoke scripts). It holds only ports and paths, no secrets.
!.env.test

# Editors
.DS_Store
.idea/
.vscode/
.commandcode/
*.swp

# Probe / temporary artifacts
*.log
probe*.txt

# E2E (Playwright)
/web/test-results/
/web/playwright-report/
/web/blob-report/
/web/.playwright/

# Knowledge-graph tool (graphify): its artifacts and local exclusion rules
# ★ graphify-out/ is a **generated artifact** (graph data, HTML reports,
#   caches) and does not belong in the repository.
#   .graphifyignore is graphify's own scan-exclusion rules, unrelated to git.
/graphify-out/
/.graphifyignore
