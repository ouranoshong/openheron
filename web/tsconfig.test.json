{
  /* Type checking for the test code.
   *
   * ★ Why a separate project: the app uses `moduleResolution: bundler`
   *   (vite + the `@/` alias) while the node side uses `nodenext` (which
   *   requires imports to carry the extension). The test code mixes browser
   *   and node, so neither rule set fits; keeping them together keeps
   *   reporting "Relative import paths need explicit file extensions".
   *   Everything is resolved with bundler here, matching what vite really does.
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "bun"],
    /* ★ Must match tsconfig.app.json: the src/** code under test imports via
       `@/`, so without this mapping the test project reports "Cannot find
       module '@/lib/api'" — and the error points at the test file, which
       easily gets misread as a problem with the test itself. */
    "paths": { "@/*": ["./src/*"] },
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["playwright.config.ts", "test/**/*.ts", "src/lib/fixtures/**/*.ts"]
}
