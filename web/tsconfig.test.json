{
  /* 测试代码的类型检查。
   *
   * ★ 为什么单独一个 project：app 走 `moduleResolution: bundler`
   *   （vite + `@/` 别名），而 node 侧是 `nodenext`（要求 import 带
   *   扩展名）。测试代码是浏览器+node 混合的，两边规则都不完全合适，
   *   放一起会一直报 "Relative import paths need explicit file
   *   extensions"。这里统一用 bundler 解析，与 vite 实际行为一致。
   */
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.test.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "types": ["node", "bun"],
    /* ★ 必须与 tsconfig.app.json 一致：被测的 src/** 源码内部用 `@/`
       导入，测试 project 没有这个映射就会报 "Cannot find module
       '@/lib/api'" —— 而且报错指向测试文件，很容易误判成测试的问题。 */
    "paths": { "@/*": ["./src/*"] },
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "erasableSyntaxOnly": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["playwright.config.ts", "test/**/*.ts", "src/lib/fixtures/**/*.ts"]
}
