*.njsproj
*.sln
*.sw?

# ★ dist/.gitkeep must stay.
#   The `dist` rule excludes the whole directory, so git never descends into
#   its children — writing `!/web/dist/.gitkeep` at the repo root does not
#   bring it back, because the nearest rule wins and web/.gitignore is more
#   specific than the root one.
#   Without it the go:embed target directory does not exist in a **fresh
#   clone**, and `go build ./...` fails outright with
#   "pattern all:web/dist: no matching files found".
!dist/
dist/*
!dist/.gitkeep
